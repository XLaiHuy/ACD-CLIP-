def _atomic_json(path: Path, payload: Mapping[str, Any]) -> None:
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="utf-8")
    os.replace(temporary, path)


def _read_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def _git(*args: str) -> str:
    return subprocess.run(["git", *args], cwd=ROOT, check=True, text=True, capture_output=True).stdout.strip()


def _prediction_records(path: Path, held_class: str, expected_hash: str, schema: str, student_key: str) -> list[dict[str, Any]]:
    prediction_hash(path, expected_hash)
    payload = torch.load(path, map_location="cpu", weights_only=True)
    if payload.get("schema_version") != schema or payload.get("held_class") != held_class:
        raise RuntimeError(f"immutable prediction schema/class mismatch: {path}")
    if payload.get("gt_used") is not False or int(payload.get("mask_reads", -1)) != 0:
        raise RuntimeError(f"immutable prediction firewall mismatch: {path}")
    records = payload.get("records")
    if not isinstance(records, list) or not records:
        raise RuntimeError(f"immutable prediction records missing: {path}")
    paths = [str(record.get("image_path", "")) for record in records]
    if not all(paths) or len(paths) != len(set(paths)):
        raise RuntimeError(f"immutable prediction identities invalid: {path}")
        raise RuntimeError(f"immutable prediction identities invalid: {path}")
    if any(not isinstance(record.get("native_abnormal_probability"), torch.Tensor) or not isinstance(record.get(student_key), torch.Tensor) for record in records):
        raise RuntimeError(f"immutable prediction tensors missing: {path}")
    return records
