      "witness_pool": "witness_local",
      "witness_aggregation": "mean",
      "stage_aggregation": "mean",
      "comparison": "peer distance <= query-to-peer distance; self excluded; witness=(1+count)/8"
    },
    "baseline_cdf": "all valid_b1 patches in the same image, per stage raw component, average ties; invalid patches excluded",
    "perturbation_cdf": "same frozen baseline CDF; never recompute or rerank a perturbation image"
