{
  "MVTec": {
    "benchmark": "tools/sabra/trust_v2/mvtec_external.py --backend fast",
    "checkpoint_selection_access": false,
    "role": "previously observed external validation and post-training frozen benchmark",
    "root_env": "MVTEC_ROOT",
    "threshold_tuning_access": false,
    "training_loader_access": false
  },
  "Medical": {
    "checkpoint_selection_access": false,
    "current_reads": 0,
    "explicit_gate": "--allow-medical-evaluation",
    "role": "clean final external evaluation after final checkpoint freeze",
    "root_env": "MEDICAL_ROOT",
    "sealed_by_default": true,
    "training_loader_access": false,
    "validation_loader_access": false
  },
  "global_constraints": {
    "MVTec_feedback_to_training": false,
    "Medical_feedback_to_training": false,
    "no_recursive_all_data_scan": true,
    "training_loader_must_not_discover_medical": true,
    "training_loader_must_not_discover_mvtec": true
  },
  "schema": "DATASET_ROLE_CONTRACT_V1",
  "train": {
    "allowed_during_20e": true,
    "dataset": "VisA",
    "loader": "dataset.get_text_and_image_dataset('VisA', 518, 'train')",
    "metadata": "dataset/hub/VisA.jsonl",
    "root_env": "VISA_ROOT",
    "split": "all rows exposed by existing train loader; no new split"
  },
  "validation": {
    "allowed_during_20e": false,
    "checkpoint_selection": "freeze adapter_20.pth before invocation; no automatic reselection",
    "dataset": "VisA",
    "implementation": "tools/sabra/trust_v2/visa_audit.py",
    "role": "post-training held-out-class LOCO validation/development evidence"
  }
}
