    "normalization_epsilon": 0.01,
    "teacher_input": "teacher_region [B,9,9] from immutable Tier-B source-only cache",
    "student_input": "student_region [3,B,9,9] from the unchanged RegionResidualAdapter",
    "staging": "T = teacher_region.unsqueeze(0).expand_as(student_region)",
    "vectors": {
      "s_b": "flatten((student_region[:,b]/C), [3,9,9]) into 243 coordinates",
      "t_b": "flatten((T[:,b]/C), [3,9,9]) into 243 coordinates",
      "r_s": "sqrt(mean(s_b^2) + epsilon^2)",
      "r_t": "sqrt(mean(t_b^2) + epsilon^2)",
      "s_hat": "s_b / r_s",
      "t_hat": "t_b / r_t"
    },
    "valid_target": "sum(abs(t_b)) > 0; exact-zero teacher direction is undefined and contributes no directional loss",
    "loss": "mean_valid_b(1 - mean_j(s_hat[b,j] * t_hat[b,j]))",
    "empty_valid_set": "return student_region.sum() * 0.0 to preserve a finite autograd graph",
    "teacher_detached": true,
    "magnitude_invariance_intended": true,
    "uses_source_mask": false,
